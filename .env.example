# Copy to .env, replace every placeholder, and keep the file out of source control.
# Generate each secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CALLBACK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Production API-key profiles: project scope + minimum required grants.
# Use a separately generated random bearer token (at least 32 characters).
UNIFIED_API_KEYS={"REPLACE_WITH_A_RANDOM_BEARER_TOKEN":{"projects":["project-a"],"grants":["repo.read","web.read.public"]}}
# Empty disables outbound web fetching; otherwise list exact audited HTTPS hostnames.
UNIFIED_WEB_ALLOWLIST=[]
