# Copy to .env for docker-compose. Never commit real secrets.
CALLBACK_SECRET=change-me-to-a-long-random-string
# JSON map of bearer tokens to allowed projects and tool grants.
# Setting this disables the built-in wildcard dev-key; omitted grants mean none.
UNIFIED_API_KEYS={"replace-with-a-long-random-token":{"projects":["project-a"],"grants":["repo.read","web.read.public"]}}
