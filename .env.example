# Copy to .env; the file contains paths, not secret values. Do not commit secrets/.
CALLBACK_SECRET_FILE=./secrets/callback_secret
UNIFIED_API_KEYS_FILE=./secrets/api_keys.json
# Empty disables outbound web fetching; otherwise list exact audited HTTPS hostnames.
UNIFIED_WEB_ALLOWLIST=[]

# Create the files and restrict them to the service account before `docker compose up`:
# umask 077 && mkdir -p secrets && chmod 700 secrets
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))' > secrets/callback_secret
# python3 -c 'import json,secrets; print(json.dumps({secrets.token_urlsafe(48): {"projects":["project-a"], "grants":["repo.read"]}}))' > secrets/api_keys.json
# sudo chown 10001:10001 secrets/callback_secret secrets/api_keys.json
# chmod 400 secrets/callback_secret secrets/api_keys.json
